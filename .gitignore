# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env / secrets
.env
.env.*
!.env.example
google-services.json
firebase-*.json
# Stable debug signing material (issue #135): the keystore and its passwords
# never enter git.
keystore.properties
*.jks

# Local data (repo root only — an unanchored `data/` would also swallow the
# Android `dev.recally.data` package).
/data/
*.db
*.sqlite3
.orca/

# Android / Gradle
*.iml
.gradle/
local.properties
**/build/
.cxx/
# Kotlin compiler session + daemon crash logs, written beside the module.
android/.kotlin/
# A Gradle user home created inside the checkout (a worker ran Gradle with
# GRADLE_USER_HOME=<repo>/android once); regenerable caches, never source.
android/.tmp/
android/android/
android/caches/
android/daemon/
android/kotlin-profile/
android/native/
android/wrapper/

# OS / editors
.DS_Store
.idea/
.vscode/

# scala-cli build output
.scala-build/
.bsp/

# Transient pip-audit export (CI)
backend/requirements-audit.txt

# Design canvas: seeded editor payload (~2.6MB), rebuildable from the
# .dc.html artboards + canvas.json. See docs/design/README.md.
docs/design/recally-style-explore.html
docs/design/icon/recally-launcher-icon.html

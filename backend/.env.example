# Mirrors docs/config.md. Copy to `backend/.env` (gitignored) and fill in.
# Only the variables the code already reads are listed; the rest are added here by the
# change that introduces the code reading them, alongside their docs/config.md row.

# Required. The value the client must send in `X-API-Key`; there is no default, so the
# app refuses to start without it. Generate one with: python -c "import secrets;
# print(secrets.token_urlsafe(32))"
RECALLY_API_KEY=

# Any SQLAlchemy URL; Postgres in phase 2/3. The path is relative to the process
# working directory, and backend commands run from `backend/` (docs/backend.md,
# "Tooling"), so set it explicitly if you want the repo-root `data/` the roadmap's
# manual gates use: RECALLY_DATABASE_URL=sqlite:///../data/recally.db
RECALLY_DATABASE_URL=sqlite:///data/recally.db

# Mirrors docs/config.md. Copy to `backend/.env` (gitignored) and fill in.
# Only the variables the code already reads are listed; the rest are added here by the
# change that introduces the code reading them, alongside their docs/config.md row.

# Required. The value the client must send in `X-API-Key`; there is no default, so the
# app refuses to start without it. Generate one with: python -c "import secrets;
# print(secrets.token_urlsafe(32))"
RECALLY_API_KEY=

# Any SQLAlchemy URL; Postgres in phase 2/3. The path is relative to the process
# working directory, and backend commands run from `backend/` (docs/backend.md,
# "Tooling"), so set it explicitly if you want the repo-root `data/` the roadmap's
# manual gates use: RECALLY_DATABASE_URL=sqlite:///../data/recally.db
RECALLY_DATABASE_URL=sqlite:///data/recally.db

# Browser-download watcher. A partial download is ignored until its rename into this
# directory; matching exports then wait this long before being read.
RECALLY_WATCH_DIR=~/Downloads
RECALLY_WATCH_DEBOUNCE_MS=2000

# IANA timezone owning every day boundary: stats streaks/"today", the one-push-per-day
# window, the new-card allotment and bury's next-midnight (docs/config.md, ADR-008).
RECALLY_TIMEZONE=Pacific/Auckland

# Per-role model tiers (LiteLLM model strings; provider credentials use LiteLLM's own
# variable names, e.g. ANTHROPIC_API_KEY). Cheap tier for Curator/Critic, stronger for
# Writer/Learner.
LLM_MODEL_CURATOR=claude-haiku-4-5-20251001
LLM_MODEL_WRITER=claude-sonnet-5
LLM_MODEL_CRITIC=claude-haiku-4-5-20251001
LLM_MODEL_LEARNER=claude-sonnet-5

# Store request/response payloads on llm_calls (the replay corpus, ADR-006). Turn off
# only if the table bloats.
LLM_LOG_PAYLOADS=true

# Max highlights per Curator call; a longer chapter is split into consecutive batches
# and grouping cannot span a batch boundary (docs/agents.md, "2. Curator Agent").
CURATOR_MAX_BATCH=40

# Writer ⇄ Critic round cap (hard rule 9; do not raise without a doc change), and the
# hard-rule-1 exception that lets round-1 Critic accepts skip the human queue.
LLM_MAX_ROUNDS=3
AUTO_APPROVE_ROUND1_ACCEPT=false

# How many curated units resolve their Writer ⇄ Critic chains in parallel (ADR-015).
# 1 is sequential, the historical path. Raise only as far as the provider's rate
# limit allows: start at 4 on a real ingest, watch for 429s, then 8.
LLM_CONCURRENCY=1

# Registered variant per agent role (ADR-007). An unknown value fails startup with a
# message naming the role and the registered variants.
AGENT_CURATOR=default
AGENT_WRITER=default
AGENT_CRITIC=default
AGENT_LEARNER=default

# FSRS (docs/config.md, "Scheduling and push"). Used until the optimizer writes an
# fsrs_params row; the latest row then overrides both.
FSRS_DESIRED_RETENTION=0.9
FSRS_LEARNING_STEPS_MINUTES=1,10
# Cap on never-reviewed cards added to the /reviews/due response per day.
NEW_CARDS_PER_DAY=10

# Push policy (hard rule 8). PUSH_WINDOW is a local-time range in RECALLY_TIMEZONE —
# a range, not two variables; no push outside it. The notifier ticks every
# PUSH_CHECK_INTERVAL_MIN minutes and sends at most one push per local day, none
# while the previous push's cards are still unreviewed. FIREBASE_CREDENTIALS_FILE is
# the service-account JSON for FCM HTTP v1; without it the notifier logs and skips.
PUSH_WINDOW=08:00-21:00
PUSH_CHECK_INTERVAL_MIN=60
FIREBASE_CREDENTIALS_FILE=

# Learner (nightly). Stage A is the FSRS fit: below OPTIMIZER_MIN_REVIEWS
# review_logs it writes nothing and library defaults stay active; the fit needs
# the optional torch/pandas extra: uv sync --extra optimizer (without it the job
# logs and no-ops). Stage B is the writer-guidance LLM job: below
# LEARNER_MIN_REVIEWS review_logs it skips — a lapse-rate bucket needs on the
# order of a hundred reviews to mean anything. LEARNER_CRON (5-field, in
# RECALLY_TIMEZONE) drives both.
OPTIMIZER_MIN_REVIEWS=400
LEARNER_MIN_REVIEWS=100
LEARNER_CRON=0 3 * * *
